# Phase 37（デスクトップ D6）: クリップボード。端末の文字をマウスでなぞって写し、シェル（Ctrl+V）と edit（Ctrl+U）に
# 貼り付ける。edit で切り取った行（Ctrl+K）も端末に貼り付けられる
# 端末 1 の中身は 8,360 から。文字は 8x16（行 r は y = 360 + 16r、桁 c は x = 8 + 8c）
timeout 30
wait-serial gui: desktop 1024x768
wait-serial VibeOS shell
type echo copy me please
key ret
# 打った文字と出力の 2 回
wait-serial copy me please
wait-serial copy me please
sleep 300
# 3 行目（出力）の "copy me"（0〜6 桁）をなぞる（カーソル 512,384 → 10,400 → 60,400）
mouse-move -502 16
mouse-button left down
mouse-move 25 0
mouse-move 25 0
mouse-button left up
wait-serial term: copied 7 bytes
sleep 200
expect-screen clip-selected 8 360 200 64
# シェルで Ctrl+V
type echo [
key ctrl+v
type ]
key ret
wait-serial [copy me]
wait-serial [copy me]
# edit で Ctrl+U（貼り付け）。2 行目に打った行を Ctrl+K で切り取る
type edit /clip.txt
key ret
wait-serial /clip.txt (new)
key ctrl+u
type edited line
key ctrl+k
sleep 200
expect-screen clip-edit 8 360 640 48
key ctrl+q
key ctrl+q
# 切り取った行を端末に貼り付ける
type echo "<
key ctrl+v
type >"
key ret
wait-serial <edited line>
wait-serial <edited line>
serial-absent PANIC
