# Phase 3: CPU 例外（0 除算）でパニック画面になる
# 期待画像は 320x200 のもの
# カーネルの中で例外を起こすシステムコールは fault-test のカーネルだけにある（DECISIONS.md D-042）
image build/vibeos-fault.img
boot-config video=320x200
timeout 15
wait-serial VIBEOS READY
type fault kdivzero
key ret
wait-serial KERNEL PANIC:
wait-serial Divide error (#DE)
sleep 200
# 見出しと例外名の行だけを比べる（以降はレジスタの値なのでビルドごとに変わる）
expect-screen panic-divzero 0 0 640 66
