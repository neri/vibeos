# M4・A1: タイトルバーのボタンは薄い地の丸。マウスを乗せると地の色が変わる（[x] は赤、[_] は濃い灰色）。離れると戻る
# clock のウィンドウは中身 120,73 に 136x156。[_] は 212〜231、[x] は 234〜253（タイトルバー y=49〜72、
# 丸は y=51〜70。記号は真ん中の 8x8 なので、丸の左寄りの 215,60 と 237,60 で見る）。カーソルは 512,384 から
timeout 30
wait-serial gui: desktop 1024x768
wait-serial VibeOS shell
type clock &
key ret
wait-serial clock: started
sleep 300
# 乗せる前は薄い地
expect-pixel 237 60 241 239 232
expect-pixel 215 60 241 239 232
# [x] に乗せる（→ 243,60）
mouse-move -269 -324
sleep 300
expect-pixel 237 60 226 67 72
expect-pixel 215 60 241 239 232
# [_] に移る（→ 222,60）
mouse-move -21 0
sleep 300
expect-pixel 237 60 241 239 232
expect-pixel 215 60 211 209 199
# 離れる（→ 222,200: 時計の中身）
mouse-move 0 140
sleep 300
expect-pixel 215 60 241 239 232
serial-absent PANIC
