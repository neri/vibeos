# M1: メモリが多ければ大きな画面（128MB・BOOT.CFG で 1920x1200）。アプリのウィンドウも動く
qemu-arg -m
qemu-arg 128M
boot-config video=1920x1200
timeout 30
wait-serial video: 1920x1200x32
wait-serial paging: framebuffer
wait-serial gui: desktop 1920x1200
wait-serial VibeOS shell
type clock &
key ret
wait-serial clock: started
sleep 500
expect-pixel 1910 1190 60 52 137
# 右上の大きな円は画面の大きさに対する割合で置く（右の真ん中が円の中）
expect-pixel 1910 600 83 74 183
# 時計のウィンドウ（中身の左上 120,73）の中は明るい灰色の地（Phase 52 から 16 色の絵）
expect-pixel 125 86 168 168 168
serial-absent PANIC
