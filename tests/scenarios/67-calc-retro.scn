# M5: 32 ビットのウィンドウのアプリ（calc）はレトロ（320x200）でも動く（色は標準のパレットの近い色になる）
boot-config video=320x200
timeout 30
wait-serial video: 320x200
wait-serial VibeOS shell
type calc
key ret
wait-serial calc: started
sleep 300
type 7*6
key ret
wait-serial calc: = 42
# 電卓が 2 倍の画面（640x400）の左上に出る（色は標準のパレットの近い色）
expect-screen calc-retro 0 0 320 350
key esc
serial-absent PANIC
