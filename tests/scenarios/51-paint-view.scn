# Phase 36（デスクトップ D5）: デスクトップでは view は画像の大きさのウィンドウ、paint は好きな大きさのキャンバスのウィンドウ
timeout 30
wait-serial gui: desktop 640x480
wait-serial VibeOS shell
# 24 ビットの画像（160x100）。ウィンドウは中身 120,47
type view /images/gradient.bmp &
key ret
wait-serial view: showing 160x100
sleep 300
expect-screen view-window-gradient 119 34 162 114
key esc
wait-serial view: closed (160x100 true color)
# 8 ビットの画像（独自のパレットは標準のパレットの近い色で出る）。2 つ目のウィンドウは中身 144,67 に 320x200
type view /images/plasma.bmp &
key ret
wait-serial view: showing 320x200
sleep 300
expect-screen view-window-plasma 143 54 322 214
key esc
wait-serial view: closed (320x200 8-bit)
# paint 200 100: 3 つ目のウィンドウは中身 168,87 に 200x112（上の 12 ピクセルは色の並び、1 色 12 ピクセル）
type paint 200 100 &
key ret
wait-serial paint: started (200x100)
sleep 300
# 黒で横の線（カーソル 320,240 → 200,150 から右へ 40）
mouse-move -120 -90
mouse-button left down
mouse-move 20 0
mouse-move 20 0
mouse-button left up
sleep 200
expect-pixel 220 150 0 0 0
# 赤（4 番、222,93）を選んで縦の線（→ 222,93 → 222,120 から下へ 40）
mouse-move -18 -57
mouse-button left down
mouse-button left up
mouse-move 0 27
mouse-button left down
mouse-move 0 20
mouse-move 0 20
mouse-button left up
sleep 300
expect-pixel 222 150 168 0 0
expect-screen paint-window 167 74 202 126
key esc
wait-serial paint: closed
serial-absent PANIC
