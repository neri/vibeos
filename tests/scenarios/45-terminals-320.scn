# Phase 32（デスクトップ D1）: 320x200（全画面）では Alt+F1〜F4 で端末を切り替える（無ければ開く）。
# 端末に属するウィンドウは端末といっしょに前に出る。Ctrl+C は見えている端末のプロセスだけを止める
boot-config video=320x200
timeout 30
wait-serial video: 320x200
wait-serial VibeOS shell
type clear
key ret
type echo first "one"
key ret
wait-serial first one
# Alt+F2 で端末 2 を開く
key alt+f2
wait-serial term: opened terminal 2
wait-serial VibeOS shell
type echo second "two"
key ret
wait-serial second two
sleep 300
# 一番上の行（ステータスバー）を除いて比べる（画面は 2 倍で取れる）
expect-screen vt2 0 16 640 384
key alt+f1
sleep 300
expect-screen vt1 0 16 640 384
# 端末 2 で clock を動かす（前面に全画面で出る）
key alt+f2
sleep 200
type clock
key ret
wait-serial clock: started
# 端末 1 に切り替えて Ctrl+C しても、clock は止まらない（端末 1 の入力の取り消しになる）
key alt+f1
sleep 300
key ctrl+c
wait-serial ^C
sleep 300
# 端末 2 に戻すと clock も前に出る（時計のウィンドウの明るい灰色の地）
key alt+f2
sleep 300
expect-pixel 10 30 168 168 168
key esc
wait-serial clock: closed
type echo back to "two"
key ret
wait-serial back to two
serial-absent opened terminal 3
serial-absent PANIC
