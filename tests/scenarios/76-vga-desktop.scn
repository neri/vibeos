# Phase 51（VGA C3）・Phase 55（白黒 W1）: 白黒の画面（モード 12h）のデスクトップ。メニューから clock を起動し、
# [_] で最小化してバーのボタンから戻す。Alt+Tab、タイトルバーのドラッグ（離すまでは点線の枠だけが動く）、[x] で閉じる
# 寸法（docs/plans/mono.md §3.4）: 上端のバー 0〜19、タイトルバー 20（下の 2 行は黒い線）、ウィンドウの黒い枠 2、
# 右下の影（フォーカスのあるもの 4・ほか 2）。フォーカスのあるタイトルバーは黒、ほかは白。背景は x + y が 6 の倍数の
# 所だけ黒の斜めの線。端末 1 の中身は 0,72 から 640x400（タイトルバーは 52〜71）。メニューは y=20 から、
# 1 項目 18（Terminal が 23〜40、clock は 7 つ目で 131〜148）。clock の中身は 120,65 から 136x170（タイトルバー 45〜64、
# [_] 212〜231、[x] 234〜253）。バーのウィンドウのボタンは x=72 から 140 ずつ（Terminal 1 が 72〜211、Clock が 212〜351）。
# バーの右（日時・空きメモリ）と時計の文字盤は時間で変わるので画面の比較に入れない
timeout 30
wait-serial gui: desktop 640x480
wait-serial VibeOS shell
sleep 300
type echo hello
key ret
wait-serial hello
sleep 300
expect-mono
expect-screen vga-desktop 0 0 380 480
# 「VibeOS」を押してメニューを開く（カーソル 320,240 → 20,10）
mouse-move -300 -230
mouse-button left down
mouse-button left up
sleep 300
expect-screen vga-menu 0 0 380 480
# clock を押す（→ 40,140）
mouse-move 20 130
mouse-button left down
mouse-button left up
wait-serial menu: started clock
wait-serial clock: started
sleep 300
# フォーカスのある clock のタイトルバーは黒、端末のタイトルバーは白
expect-pixel 200 48 0 0 0
expect-pixel 400 60 255 255 255
expect-mono
# [_] で最小化する（→ 222,55）。ウィンドウは消えて背景（200,48 は線の無い所で白）が見え、端末にフォーカスが移る
mouse-move 182 -85
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 200 48 255 255 255
expect-pixel 198 48 0 0 0
expect-pixel 400 60 0 0 0
expect-screen vga-bar-minimized 0 0 380 20
# バーの Clock のボタンを押すと戻る（→ 280,10）
mouse-move 58 -45
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 200 48 0 0 0
expect-pixel 400 60 255 255 255
# Alt+Tab で端末が前に出る。もう一度で clock に戻る
key alt+tab
sleep 300
expect-pixel 400 60 0 0 0
expect-pixel 200 48 255 255 255
key alt+tab
sleep 300
expect-pixel 200 48 0 0 0
# clock のタイトルバーをつかみ（→ 160,55）、150,100 動かす。離すまではウィンドウは元の所のまま、
# 点線の枠（2 ピクセル、白と黒が 1 つおき）だけが新しい所（中身 270,165、枠の左端 268・上端 143）に出る
mouse-move -120 45
mouse-button left down
mouse-move 75 50
mouse-move 75 50
sleep 300
expect-pixel 200 48 0 0 0
expect-pixel 268 250 0 0 0
expect-pixel 269 250 255 255 255
expect-screen vga-drag-outline 260 140 160 200
# 離すとウィンドウが動き、枠は消える（左の枠は 2 ピクセルの黒い線になる）
mouse-button left up
sleep 300
expect-pixel 200 48 255 255 255
expect-pixel 350 150 0 0 0
expect-pixel 268 250 0 0 0
expect-pixel 269 250 0 0 0
# [x] で閉じる（→ 394,155）。後ろの端末（黒）が見える。clock の枠の右（406）にあった影も消えて端末の黒
mouse-move 84 0
mouse-button left down
mouse-button left up
wait-serial clock: closed
sleep 300
expect-pixel 350 150 0 0 0
expect-mono
expect-screen vga-desktop-closed 0 0 380 20
serial-absent PANIC
