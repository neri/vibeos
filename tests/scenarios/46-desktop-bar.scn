# Phase 33（デスクトップ D2）: 上端のバーのメニューからアプリを起動し、最小化してバーのボタンから戻す（マウスだけで）。
# Alt+Tab でウィンドウを切り替える
# メニューの項目は 1 つ 10 ピクセル（Terminal が y=12〜21、続けて /BIN のアプリの名前の順。clock は blocks・calc の次の 4 つ目で 42〜51）。clock のウィンドウは中身 120,47 に
# 136x156（[_] は 234〜242, 36〜44）。バーのウィンドウのボタンは x=60 から 96 ピクセルずつ（作った順）
timeout 30
wait-serial gui: desktop 640x480
wait-serial VibeOS shell
sleep 300
# 「VibeOS」を押してメニューを開く（カーソル 320,240 → 20,5）
mouse-move -300 -235
mouse-button left down
mouse-button left up
sleep 300
# 時計の写る右側は除く
expect-screen bar-menu 0 0 240 200
# clock を押す（→ 30,47）
mouse-move 10 42
mouse-button left down
mouse-button left up
wait-serial menu: started clock
wait-serial clock: started
sleep 300
# 時計の文字盤（白）とフォーカスのあるタイトルバー（青）
expect-pixel 125 60 255 255 255
expect-pixel 200 40 0 0 168
# [_] で最小化する（→ 238,40）。ウィンドウは消えてバーのボタンだけになる
mouse-move 208 -7
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 125 60 0 103 55
expect-pixel 200 40 0 103 55
expect-screen bar-minimized 0 0 300 10
# バーの clock のボタン（156〜249）を押すと戻る（→ 200,5）
mouse-move -38 -35
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 125 60 255 255 255
expect-pixel 200 40 0 0 168
# Alt+Tab で端末が前に出る。もう一度で clock に戻る
key alt+tab
sleep 300
expect-pixel 100 210 0 0 168
expect-pixel 200 40 87 87 87
key alt+tab
sleep 300
expect-pixel 200 40 0 0 168
expect-pixel 100 210 87 87 87
# フォーカスのあるウィンドウのボタンを押すと最小化する
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 125 60 0 103 55
# メニューの Terminal で新しい端末を開く（→ 20,5 → 30,17）
mouse-move -180 0
mouse-button left down
mouse-button left up
sleep 200
mouse-move 10 12
mouse-button left down
mouse-button left up
wait-serial term: opened terminal 2
sleep 300
# バーに 3 つのボタン（Terminal 1・最小化した clock・フォーカスのある Terminal 2）
expect-screen bar-three 0 0 360 10
type echo hello from "two"
key ret
wait-serial hello from two
serial-absent PANIC
