# Phase 33（デスクトップ D2）: 上端のバーのメニューからアプリを起動し、最小化してバーのボタンから戻す（マウスだけで）。
# Alt+Tab でウィンドウを切り替える
# メニューの項目は 1 つ 22 ピクセル（Terminal が y=28〜49、続けて /BIN のアプリの名前の順。clock は arp・beep・blocks・calc の
# 次の 6 つ目で 138〜159）。入りきらない分は右の列。clock のウィンドウは中身 120,73 に 136x156（[_] は 212〜231, 49〜72）。
# バーのウィンドウのボタンは x=72 から 140 ピクセルずつ（作った順）
timeout 30
wait-serial gui: desktop 1024x768
wait-serial VibeOS shell
sleep 300
# 「VibeOS」を押してメニューを開く（カーソル 512,384 → 20,10）
mouse-move -492 -374
mouse-button left down
mouse-button left up
sleep 300
# 時計の写る右側は除く
expect-screen bar-menu 0 0 260 768
# clock を押す（→ 30,148）
mouse-move 10 138
mouse-button left down
mouse-button left up
wait-serial menu: started clock
wait-serial clock: started
sleep 300
# 時計の文字盤（白）とフォーカスのあるタイトルバー（明るい地。フォーカスが無いと灰色）
expect-pixel 125 86 255 255 255
expect-pixel 200 70 250 250 251
# [_] で最小化する（→ 222,60）。ウィンドウは消えてバーのボタンだけになる
mouse-move 192 -88
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 125 86 71 111 195
expect-pixel 200 60 68 112 195
expect-screen bar-minimized 0 0 400 24
# バーの clock のボタン（212〜349）を押すと戻る（→ 280,10）
mouse-move 58 -50
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 125 86 255 255 255
expect-pixel 200 70 250 250 251
# Alt+Tab で端末が前に出る。もう一度で clock に戻る
key alt+tab
sleep 300
expect-pixel 100 357 250 250 251
expect-pixel 200 70 232 233 237
key alt+tab
sleep 300
expect-pixel 200 70 250 250 251
expect-pixel 100 357 232 233 237
# フォーカスのあるウィンドウのボタンを押すと最小化する
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 125 86 71 111 195
# メニューの Terminal で新しい端末を開く（→ 20,10 → 30,38）
mouse-move -260 0
mouse-button left down
mouse-button left up
sleep 200
mouse-move 10 28
mouse-button left down
mouse-button left up
wait-serial term: opened terminal 2
sleep 300
# バーに 3 つのボタン（Terminal 1・最小化した clock・フォーカスのある Terminal 2）
expect-screen bar-three 0 0 640 24
type echo hello from "two"
key ret
wait-serial hello from two
serial-absent PANIC
