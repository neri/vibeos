# Phase 46（ブラウザ B2）: フロッピーのページを browse で表示する。テスト用のページ（tests/web）はイメージの写しの
# /DOCS/WEB に入れる（普通のイメージには入れない。DECISIONS.md D-068）。
# Phase 52（VGA C4）から 16 色の画面で。ウィンドウは中身 3,63 に 636x416（上の道具の並び 36、
# 下の行 20。タイトルバーは 43〜62）。画面は枠を含むウィンドウ全体（2,42 から 638x438）で比べる。下の行の文字は
# 6,460 から 500x18 で比べる。リンクの位置（画面の座標。文字は 8x16 の固定幅）:
# INDEX.HTM の "a link to page 2" 480,148・"the lists below" 130,164、
# PAGE2.HTM の "a text file" 494,148・"secure page" 95,192。[x] は 627,52
disk-put tests/web/INDEX.HTM /DOCS/WEB/INDEX.HTM
disk-put tests/web/PAGE2.HTM /DOCS/WEB/PAGE2.HTM
timeout 30
wait-serial gui: desktop 640x480
wait-serial VibeOS shell
type browse /DOCS/WEB/INDEX.HTM &
key ret
wait-serial browse: loaded file:///DOCS/WEB/INDEX.HTM (
sleep 500
# 見出し・段落・太字・等幅・リンク・文字参照・長い単語・引用・pre・水平線・リスト。script と style の中身は出ない
expect-screen browse-index 2 42 638 438
serial-absent must not be shown
# キーでスクロール（PageDown）
key pgdn
sleep 300
expect-screen browse-scrolled 2 42 638 438
key home
sleep 300
# リンクに乗せると下の行に行き先が出る（カーソル 320,240 → 480,148）
mouse-move 160 -92
sleep 300
expect-screen browse-hover 2 42 638 438
expect-screen browse-hover-status 6 460 500 18
# 押すと 2 ページ目へ。タイトルが変わる
mouse-button left down
mouse-button left up
wait-serial browse: link file:///DOCS/WEB/PAGE2.HTM
wait-serial browse: loaded file:///DOCS/WEB/PAGE2.HTM (
wait-serial "Page two"
sleep 300
# https のリンクは開かずに下の行に知らせる（→ 95,192）
mouse-move -385 44
mouse-button left down
mouse-button left up
wait-serial browse: https://example.com/: HTTPS is not supported
sleep 300
expect-screen browse-https 2 42 638 438
expect-screen browse-https-status 6 460 500 18
# テキストのファイルは等幅でそのまま（→ 494,148）
mouse-move 399 -44
mouse-button left down
mouse-button left up
wait-serial browse: loaded file:///DOCS/README.TXT (
sleep 300
expect-screen browse-text 2 42 638 438
# 戻る・進む（Alt+← / Alt+→）
key alt+left
wait-serial browse: loaded file:///DOCS/WEB/PAGE2.HTM (
key alt+left
wait-serial browse: loaded file:///DOCS/WEB/INDEX.HTM (
key alt+right
wait-serial browse: loaded file:///DOCS/WEB/PAGE2.HTM (
key alt+left
wait-serial browse: loaded file:///DOCS/WEB/INDEX.HTM (
sleep 300
# 同じページの中の印（#lists）へは読み直さずに動く（→ 130,164）
mouse-move -364 16
mouse-button left down
mouse-button left up
wait-serial browse: moved to file:///DOCS/WEB/INDEX.HTM#lists
sleep 300
expect-screen browse-lists 2 42 638 438
# Ctrl+L でアドレス欄へ。フォルダは一覧のページになる
key ctrl+l
type /DOCS/
key ret
wait-serial browse: loaded file:///DOCS/ (
sleep 300
expect-screen browse-dir 2 42 638 438
# [x] で閉じる（→ 627,52）
mouse-move 497 -112
mouse-button left down
mouse-button left up
wait-serial browse: closed
# ファイルマネージャで .HTM をダブルクリックすると browse で開く
type files /DOCS/WEB &
key ret
wait-serial files: started
sleep 300
# 一覧は .., INDEX.HTM, PAGE2.HTM（ウィンドウは中身 144,85。INDEX.HTM は 215,143 → カーソル 627,52 から）
mouse-move -412 91
mouse-button left down
mouse-button left up
mouse-button left down
mouse-button left up
# files の "files: opened … with browse" の行は、起動した browse の出力が途中に割り込むことがある
# （println! は書式の部分ごとに書く）ので、browse が開いたことだけを待つ
wait-serial browse: loaded file:///DOCS/WEB/INDEX.HTM (
serial-absent PANIC
