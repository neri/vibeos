# Phase 46（ブラウザ B2）: フロッピーのページを browse で表示する。テスト用のページ（tests/web）はイメージの写しの
# /DOCS/WEB に入れる（普通のイメージには入れない。DECISIONS.md D-068）。
# ウィンドウは中身 120,73 に 640x480（上の道具の並び 36、下の行 20）。リンクの位置（画面の座標）:
# INDEX.HTM の "a link to page 2" 480,167・"the lists below" 650,167、
# PAGE2.HTM の "a text file" 478,167・"secure page" 193,198。[x] は 747,61
disk-put tests/web/INDEX.HTM /DOCS/WEB/INDEX.HTM
disk-put tests/web/PAGE2.HTM /DOCS/WEB/PAGE2.HTM
timeout 30
wait-serial gui: desktop 1024x768
wait-serial VibeOS shell
type browse /DOCS/WEB/INDEX.HTM &
key ret
wait-serial browse: loaded file:///DOCS/WEB/INDEX.HTM (
sleep 500
# 見出し・段落・太字・等幅・リンク・文字参照・長い単語・引用・pre・水平線・リスト。script と style の中身は出ない
expect-screen browse-index 120 49 640 504
serial-absent must not be shown
# キーでスクロール（PageDown）
key pgdn
sleep 300
expect-screen browse-scrolled 120 49 640 504
key home
sleep 300
# リンクに乗せると下の行に行き先が出る（カーソル 512,384 → 480,167）
mouse-move -32 -217
sleep 300
expect-screen browse-hover 120 49 640 504
# 押すと 2 ページ目へ。タイトルが変わる
mouse-button left down
mouse-button left up
wait-serial browse: link file:///DOCS/WEB/PAGE2.HTM
wait-serial browse: loaded file:///DOCS/WEB/PAGE2.HTM (
wait-serial "Page two"
sleep 300
# https のリンクは開かずに下の行に知らせる（→ 193,198）
mouse-move -287 31
mouse-button left down
mouse-button left up
wait-serial browse: https://example.com/: HTTPS is not supported
sleep 300
expect-screen browse-https 120 49 640 504
# テキストのファイルは等幅でそのまま（→ 478,167）
mouse-move 285 -31
mouse-button left down
mouse-button left up
wait-serial browse: loaded file:///DOCS/README.TXT (
sleep 300
expect-screen browse-text 120 49 640 504
# 戻る・進む（Alt+← / Alt+→）
key alt+left
wait-serial browse: loaded file:///DOCS/WEB/PAGE2.HTM (
key alt+left
wait-serial browse: loaded file:///DOCS/WEB/INDEX.HTM (
key alt+right
wait-serial browse: loaded file:///DOCS/WEB/PAGE2.HTM (
key alt+left
wait-serial browse: loaded file:///DOCS/WEB/INDEX.HTM (
sleep 300
# 同じページの中の印（#lists）へは読み直さずに動く（→ 650,167）
mouse-move 172 0
mouse-button left down
mouse-button left up
wait-serial browse: moved to file:///DOCS/WEB/INDEX.HTM#lists
sleep 300
expect-screen browse-lists 120 49 640 504
# Ctrl+L でアドレス欄へ。フォルダは一覧のページになる
key ctrl+l
type /DOCS/
key ret
wait-serial browse: loaded file:///DOCS/ (
sleep 300
expect-screen browse-dir 120 49 640 504
# [x] で閉じる（→ 747,61）
mouse-move 97 -106
mouse-button left down
mouse-button left up
wait-serial browse: closed
# ファイルマネージャで .HTM をダブルクリックすると browse で開く
type files /DOCS/WEB &
key ret
wait-serial files: started
sleep 300
# 一覧は .., INDEX.HTM, PAGE2.HTM（ウィンドウは中身 145,93。INDEX.HTM は 215,151 → カーソル 747,61 から）
mouse-move -532 90
mouse-button left down
mouse-button left up
mouse-button left down
mouse-button left up
wait-serial files: opened /DOCS/WEB/INDEX.HTM with browse
wait-serial browse: loaded file:///DOCS/WEB/INDEX.HTM (
serial-absent PANIC
