# Phase 2: Rust カーネルが起動し、フォントで画面に文字を描く
# 期待画像は 320x200 のもの
boot-config video=320x200
timeout 15
wait-serial VibeOS kernel starting
wait-serial Hello from Rust!
wait-serial VIBEOS READY
serial-absent PANIC
sleep 200
# 2〜3 行目（"VibeOS" と "Hello from Rust!"）だけを比べる。1 行目はステータスバー（時刻が変わる）、
# 4 行目以降はビルドごとに変わる値を含む
expect-screen phase2-hello 0 16 640 32
