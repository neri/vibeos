# M1: 32 ビットの VESA のモードが無いビデオカード（QEMU の cirrus）ではレトロ（320x200）になる
qemu-arg -vga
qemu-arg cirrus
boot-config video=auto
timeout 30
wait-serial no 32-bit VESA mode
wait-serial video: 320x200
wait-serial VIBEOS READY
wait-serial VibeOS shell
type hello
key ret
wait-serial primes below 20000: 2262
serial-absent paging: framebuffer
serial-absent PANIC
