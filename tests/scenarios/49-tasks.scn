# Phase 36（デスクトップ D5）: タスクマネージャ。タスクの一覧を出し、裏で動いているプロセス（life）を止められる
# Phase 52（VGA C4）から 16 色の画面（video=vga）で。life のウィンドウは中身 120,65 に 192x144（タイトルバー 45〜64）、
# tasks は 144,85 に 320x300（End task のボタンは 152〜241, 355〜378）
boot-config video=vga
timeout 30
wait-serial gui: desktop 640x480
wait-serial VibeOS shell
type life &
key ret
wait-serial life: started
sleep 300
# life にフォーカスが移るので、Alt+Tab で端末に戻してから tasks を起動する
key alt+tab
sleep 200
type tasks &
key ret
wait-serial tasks: started
sleep 1500
# 見出しの行（毎回同じ）
expect-screen tasks-header 148 89 312 20
expect-pixel 250 47 128 128 128
# 一覧は番号の順。最後が tasks 自身、その 1 つ前が life
key end
key up
# End task（→ 197,367）→ 確かめるダイアログで Enter（Yes）
mouse-move -123 127
mouse-button left down
mouse-button left up
sleep 300
key ret
wait-serial tasks: killed
wait-serial (life.ELF)
sleep 500
# life のウィンドウが消えた（端末の上に見えていた life のタイトルバー（濃い灰色）の所が背景（青緑）に戻る）
expect-pixel 250 47 0 128 128
# カーネルスレッドは止められない（先頭の boot か idle を選んで Delete キー）
key home
key delete
sleep 300
serial-absent tasks: killed 0
serial-absent PANIC
