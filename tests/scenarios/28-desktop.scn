# Phase 15: ウィンドウシステム（1024x768）。ウィンドウを開く・前に出す・動かす・閉じる
# 端末は左下（中身 8,360 から 640x400、タイトルバー y=336〜359）、新しいウィンドウは中身 120,73 から
# （タイトルバー y=49〜72）。カーソルは真ん中（512,384）から始まる。
# タイトルバーの地はフォーカスの有無で変わらないので、フォーカスはボタンの記号の色で見る（A1）:
# 端末の [_] の線（635,348）は明るい灰色 222,221,214 / 薄い灰色 128,128,122、
# アプリの [x] の真ん中（右端から 13・タイトルバーの上から 11）は 44,44,42 / 136,135,128
timeout 30
wait-serial gui: desktop 1024x768
wait-serial VibeOS shell
sleep 300
# 端末のタイトルバー（中身と同じ暗い地。文字の無い下の方の行で見る）と、フォーカスのある [_]、1 行目
expect-pixel 100 357 26 28 34
expect-pixel 635 348 222 221 214
expect-screen desktop-terminal 0 334 660 44
# mandel を裏で動かす → 新しいウィンドウ（中身 120,73 に 320x200）が前に出てフォーカスを持つ
type mandel &
key ret
wait-serial mandel: rendered
sleep 300
expect-pixel 200 70 255 255 255
expect-pixel 427 60 44 44 42
expect-pixel 635 348 128 128 122
# タイトルバー（300,60）をつかんで (+100, +230) 動かす → 中身の左上が (220, 303)、タイトルバーは y=279〜302
mouse-move -212 -324
mouse-button left down
mouse-move 50 115
mouse-move 50 115
mouse-button left up
sleep 300
# 新しい位置のタイトルバーは白い地（カーソルの下を避ける）、元の位置は既定の背景（紫の地。右の方は大きな円の色）
expect-pixel 430 300 255 255 255
expect-pixel 527 290 44 44 42
expect-pixel 200 60 60 52 137
# 時計や描画時間が写る上端のバー・端末の文字は除き、mandel のウィンドウ（枠を含む）だけを比べる
expect-screen desktop-moved 219 278 322 226
# 端末の中身（150,370）をクリックすると端末が前に出る（mandel の下の方は端末の下に隠れる。端末の地は濃い灰色）
mouse-move -250 80
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 635 348 222 221 214
expect-pixel 527 290 136 135 128
expect-pixel 400 400 26 28 34
type echo terminal has focus
key ret
wait-serial terminal has focus
# 端末の上にはみ出している mandel のタイトルバー（480,300）をクリックして前に出し、[x]（518〜537）で閉じる
mouse-move 330 -70
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 527 290 44 44 42
mouse-move 48 -10
mouse-button left down
mouse-button left up
sleep 500
# 閉じた場所は背景か端末の中身（黒）に戻る
expect-pixel 400 290 60 52 137
expect-pixel 400 400 26 28 34
expect-pixel 560 300 83 74 183
type ps
key ret
wait-serial shell
serial-absent ^C
serial-absent PANIC
