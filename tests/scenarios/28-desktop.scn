# Phase 15: ウィンドウシステム（1024x768）。ウィンドウを開く・前に出す・動かす・閉じる
# 端末は左下（中身 8,360 から 640x400、タイトルバー y=336〜359）、新しいウィンドウは中身 120,73 から
# （タイトルバー y=49〜72）。カーソルは真ん中（512,384）から始まる
timeout 30
wait-serial gui: desktop 1024x768
wait-serial VibeOS shell
sleep 300
# 端末のタイトルバー（フォーカスがあるので明るい地。文字の無い下の方の行で見る）と 1 行目
expect-pixel 100 357 250 250 251
expect-screen desktop-terminal 0 334 660 44
# mandel を裏で動かす → 新しいウィンドウ（中身 120,73 に 320x200）が前に出てフォーカスを持つ
type mandel &
key ret
wait-serial mandel: rendered
sleep 300
expect-pixel 200 70 250 250 251
expect-pixel 100 357 232 233 237
# タイトルバー（300,60）をつかんで (+100, +230) 動かす → 中身の左上が (220, 303)、タイトルバーは y=279〜302
mouse-move -212 -324
mouse-button left down
mouse-move 50 115
mouse-move 50 115
mouse-button left up
sleep 300
# 新しい位置のタイトルバーは明るい地（カーソルの下を避ける）、元の位置は背景のグラデーション
expect-pixel 430 300 250 250 251
expect-pixel 200 60 68 112 195
# 時計や描画時間が写る上端のバー・端末の文字は除き、mandel のウィンドウ（枠を含む）だけを比べる
expect-screen desktop-moved 219 278 322 226
# 端末の中身（150,370）をクリックすると端末が前に出る（mandel の下の方は端末の下に隠れる。端末の地は濃い灰色）
mouse-move -250 80
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 100 357 250 250 251
expect-pixel 400 300 232 233 237
expect-pixel 400 400 26 28 34
type echo terminal has focus
key ret
wait-serial terminal has focus
# 端末の上にはみ出している mandel のタイトルバー（480,300）をクリックして前に出し、[x]（518〜537）で閉じる
mouse-move 330 -70
mouse-button left down
mouse-button left up
sleep 300
expect-pixel 400 300 250 250 251
mouse-move 48 -10
mouse-button left down
mouse-button left up
sleep 500
# 閉じた場所は背景か端末の中身（黒）に戻る
expect-pixel 400 290 93 109 192
expect-pixel 400 400 26 28 34
expect-pixel 560 300 94 109 192
type ps
key ret
wait-serial shell
serial-absent ^C
serial-absent PANIC
