# Phase 10: アプリ群（mandel / snake / more）
# Phase 52（VGA C4）から 16 色の画面（video=vga）で。mandel と snake は 320x200 のウィンドウ
# （1 つ目は中身 120,65、2 つ目は 144,85）
boot-config video=vga
timeout 40
wait-serial gui: desktop 640x480
wait-serial VibeOS shell
# マンデルブロ集合（決まった絵になる）
type mandel
key ret
wait-serial mandel: rendered
sleep 200
expect-screen mandel 120 65 320 200
key esc
sleep 300
# ヘビのゲーム: 動き続け、矢印で曲がり、Esc で終わる
type snake
key ret
wait-serial snake: started
expect-change 144 105 320 180 500
key up
sleep 300
key left
sleep 300
key esc
wait-serial snake: best score
# テキストを 1 画面ずつ
type more /docs/guide.txt
key ret
wait-serial VibeOS GUIDE
wait-serial -- more (
key spc
# ガイドの内容に左右されないよう、2 ページ目のプロンプトが出ることだけを確かめる
wait-serial -- more (
key q
type echo after more
key ret
wait-serial after more
serial-absent PANIC
