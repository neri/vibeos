# A4: /SYSTEM/DOCK.CFG が無ければドックを出さずに起動する。端末は画面の下の方まで使う（ドックの分を空けない。
# 中身 8,360 から、タイトルバー y=336〜359）
disk-delete /SYSTEM/DOCK.CFG
timeout 30
wait-serial dock: /SYSTEM/DOCK.CFG is not available
wait-serial gui: desktop 1024x768
wait-serial VibeOS shell
sleep 300
# ドックのあった所（真ん中の下）は背景、端末のタイトルバー（暗いすりガラス）はドックがあるときより下
expect-pixel 900 730 60 52 137
expect-pixel 100 357 33 33 55
serial-absent dock: launch
serial-absent PANIC
