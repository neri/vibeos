# Phase 34（デスクトップ D3）: 電卓。ボタンをマウスで押して計算し、結果が合う（画面とシリアル）。キーボードでも打てる
# Phase 52（VGA C4）から 16 色の画面（video=vga）で。ウィンドウは中身 120,65 に 156x172（タイトルバー 45〜64、
# [x] 254〜273）。ボタンは 4 列 x 5 行で、列 c の左端は 128 + 36c（幅 32）、行 r の上端は 103 + 26r（高さ 22）
boot-config video=vga
timeout 30
wait-serial gui: desktop 640x480
wait-serial VibeOS shell
type calc &
key ret
wait-serial calc: started
sleep 300
# 1 2 + 3 4 =（カーソル 320,240 → 144,192 → 180,192 → 252,192 → 216,192 → 144,166 → 252,220）
mouse-move -176 -48
mouse-button left down
mouse-button left up
mouse-move 36 0
mouse-button left down
mouse-button left up
mouse-move 72 0
mouse-button left down
mouse-button left up
mouse-move -36 0
mouse-button left down
mouse-button left up
mouse-move -72 -26
mouse-button left down
mouse-button left up
mouse-move 108 54
mouse-button left down
mouse-button left up
wait-serial calc: = 46
sleep 300
expect-screen calc-46 119 44 158 194
# キーボード: 7 / 2 Enter → 3.5、続けて * 4 = → 14
type 7/2
key ret
wait-serial calc: = 3.5
type *4=
wait-serial calc: = 14
# 0 で割るとエラー。Esc で消える
type 1/0
key ret
wait-serial calc: = Error
key esc
sleep 300
expect-screen calc-cleared 127 73 142 26
# [x] で終わる（→ 264,55）
mouse-move 12 -165
mouse-button left down
mouse-button left up
wait-serial calc: closed
serial-absent PANIC
