# Phase 37（デスクトップ D6）: デスクトップの背景の画像（BOOT.CFG の wallpaper= と、シェルの wallpaper）。
# 画像は読むときに 16 色に誤差拡散し、画面全体に並べる（上端のバーは画像の上に描く）。
# 端末 1（中身 0,72 から 640x400、タイトルバー y=52〜71）がほぼ全体を覆うので、敷き詰めはバーと端末の間
# （y=20〜50）で見る
boot-config wallpaper=/IMAGES/PLASMA.BMP tile
timeout 30
wait-serial gui: desktop 640x480
wait-serial gui: wallpaper /IMAGES/PLASMA.BMP
wait-serial VibeOS shell
sleep 300
expect-screen wallpaper-tile 0 20 640 31
# 真ん中に 1 枚（160x100 の gradient を画面の真ん中 240,190 に）。周りは背景の色（青緑）
type wallpaper /images/gradient.bmp center
key ret
sleep 500
# 端末が重なるので [_]（618〜637, 52〜71）で最小化して見る（カーソル 320,240 → 627,61）
mouse-move 307 -179
mouse-button left down
mouse-button left up
sleep 300
expect-screen wallpaper-center 236 186 168 108
expect-pixel 600 30 0 128 128
# バーの Terminal 1 のボタン（→ 100,10）で戻す。カーソルは比べる所の外へ（→ 100,300）
mouse-move -527 -51
mouse-button left down
mouse-button left up
mouse-move 0 290
sleep 300
# 敷き詰めてから背景の画像をやめる（バーと端末の間が plasma → 背景の色）
type wallpaper /images/plasma.bmp tile
key ret
sleep 300
expect-screen wallpaper-tile 0 20 640 31
type wallpaper none
key ret
sleep 300
expect-pixel 630 30 0 128 128
type wallpaper /hello.txt
key ret
wait-serial wallpaper: /hello.txt: not a BMP file
serial-absent PANIC
