# Phase 15: アプリが好きな大きさのウィンドウを開き、キー・マウス・閉じる要求のイベントを受け取る
timeout 30
wait-serial gui: desktop 640x480
wait-serial VibeOS shell
# 時計（中身 120,65 に 136x170、タイトルバー 45〜64）。[x]（234〜253）で閉じると、アプリが閉じる要求を受けて終わる
type clock &
key ret
wait-serial clock: started
sleep 300
# フォーカスのある時計のタイトルバー（黒）と、時計の地（白）
expect-pixel 200 48 0 0 0
expect-pixel 125 78 255 255 255
# [x] を押す（カーソル 320,240 → 243,55）
mouse-move -77 -185
mouse-button left down
mouse-button left up
wait-serial clock: closed
sleep 300
# 時計のあった所は背景（斜めの線。198,48 は線の上、200,48 は線の無い所）に戻る
expect-pixel 198 48 0 0 0
expect-pixel 200 48 255 255 255
# ライフゲーム（2 つ目のウィンドウは中身 144,85 に 192x144、セルは 4 ピクセル）。空いているセル (10,10) を
# クリックで生かす（→ 185,126）
type life &
key ret
wait-serial life: started
sleep 300
mouse-move -58 71
mouse-button left down
mouse-button left up
sleep 300
# カーソルの先（185,126）と重ならないセルの上の行で確かめる（セルは 184〜186, 125〜127）。生きたセルは黒、
# 隣の死んだセル（180〜182）は白
expect-pixel 185 125 0 0 0
expect-pixel 181 125 255 255 255
# スペースで動かし、Esc で終わる（世代が進んでいる）
key spc
wait-serial life: running
sleep 500
key esc
wait-serial life: closed after
serial-absent life: closed after 0 generations
serial-absent PANIC
