# Phase 32（デスクトップ D1）: 端末を何個でも開ける。出力はそれぞれの端末に出る。edit は端末の大きさ（80x25）を使う。
# 端末を閉じると、その端末のプロセスも止まる
# 端末 1 は中身 8,360 から 640x400。端末 2 は中身 120,73 から 640x400（タイトルバー y=49〜72、[x] は 738〜757）
timeout 30
wait-serial gui: desktop 1024x768
wait-serial VibeOS shell
type term
key ret
wait-serial term: opened terminal 2
wait-serial VibeOS shell
sleep 300
# 新しい端末にフォーカスがある。打った文字（引用符付き）と出力（引用符なし）を見分ける
type echo in "two"
key ret
wait-serial in two
# 端末 1 の見えている所をクリックして前に出す（カーソル 512,384 → 60,600）
mouse-move -452 216
mouse-button left down
mouse-button left up
sleep 200
type echo in "one"
key ret
wait-serial in one
sleep 300
# 上端のバー（時計）を除いて比べる
expect-screen terminals-two 0 24 1024 744
# edit は 80 桁 x 25 行を使う（1 行目にファイル名、25 行目にキーの説明）
type edit /new.txt
key ret
wait-serial /new.txt (new)
sleep 300
expect-screen terminals-edit 8 360 640 400
key ctrl+q
# 端末 2 をクリックして前に出し（→ 400,100）、裏で clock、前面で life を動かす
mouse-move 340 -500
mouse-button left down
mouse-button left up
sleep 200
type clock &
key ret
wait-serial clock: started
sleep 200
# 新しいウィンドウ（clock）にフォーカスが移るので、端末 2 をもう一度クリックする（→ 500,150）
mouse-move 100 50
mouse-button left down
mouse-button left up
sleep 200
type life
key ret
wait-serial life: started
sleep 300
# 端末 2 の [x]（→ 747,60）で閉じると、clock と life も止まり、シェルが終わってウィンドウが消える
mouse-move 247 -90
mouse-button left down
mouse-button left up
wait-serial term: stopping clock.ELF
wait-serial term: stopping life.ELF
wait-serial term: closed terminal 2
sleep 500
# 端末 2・clock・life のあった所は背景に戻る
expect-pixel 600 100 72 111 195
expect-pixel 200 150 78 111 194
expect-pixel 300 200 83 110 193
# フォーカスは端末 1 に戻る
type echo "still" here
key ret
wait-serial still here
serial-absent PANIC
