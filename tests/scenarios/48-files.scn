# Phase 35（デスクトップ D4）: ファイルマネージャ。フォルダを移り、BMP をダブルクリックで view が開く。
# コピー・名前の変更（移動）・削除・フォルダ作りがフロッピー（ホスト側の mtools）にも反映される。テキストは新しい端末の edit で開く
# Phase 52（VGA C4）から 16 色の画面で。ウィンドウは中身 120,65 に 320x224（タイトルバー 45〜64）。
# 一覧の i 行目は y = 93 + 20i から 20 ピクセル。
# ボタン（y = 241〜264）の中心の x: Open 156, Copy 218, Rename 280, Delete 342, Folder 404
writable
timeout 40
wait-serial gui: desktop 640x480
wait-serial VibeOS shell
type files &
key ret
wait-serial files: started
sleep 300
# ルート: BIN, DOCS, IMAGES（フォルダが先）。IMAGES（2 行目）をダブルクリック（カーソル 320,240 → 200,150）
mouse-move -120 -90
mouse-button left down
mouse-button left up
mouse-button left down
mouse-button left up
wait-serial files: dir /IMAGES
sleep 300
expect-screen files-images 119 44 322 246
# /IMAGES: .., GRADIENT.BMP, PLASMA.BMP。PLASMA.BMP（同じ 2 行目）をダブルクリックすると view が開く
mouse-button left down
mouse-button left up
mouse-button left down
mouse-button left up
# " with view" の前に起動した view の出力が割り込むことがある（println! は書式の部分ごとに書く）ので、その前までを待つ
wait-serial files: opened /IMAGES/PLASMA.BMP
wait-serial view: showing
sleep 300
key esc
wait-serial view: closed
sleep 300
# キーボード: BackSpace で親へ（IMAGES を選んだまま）→ ↑ で DOCS → Enter で入る → ↓ で GUIDE.TXT
key backspace
wait-serial files: dir /
key up
key ret
wait-serial files: dir /DOCS
key down
# コピー（→ 218,253）。ダイアログに名前を打って Enter
mouse-move 18 103
mouse-button left down
mouse-button left up
sleep 300
type COPY.TXT
key ret
wait-serial files: copied /DOCS/GUIDE.TXT to /DOCS/COPY.TXT
expect-disk-file DOCS/COPY.TXT VibeOS GUIDE
# 名前の変更（→ 280,253）で別のフォルダ（ルート）へ移す。最初は今の名前を選んだ状態なので、打てば置き換わる
mouse-move 62 0
mouse-button left down
mouse-button left up
sleep 300
type /MOVED.TXT
key ret
wait-serial files: renamed /DOCS/COPY.TXT to /MOVED.TXT
expect-disk-file MOVED.TXT VibeOS GUIDE
expect-disk-missing DOCS/COPY.TXT
# 削除: End で README.TXT → Delete キー → 確かめるダイアログで Enter（Yes）
key end
key delete
sleep 300
key ret
wait-serial files: deleted /DOCS/README.TXT
expect-disk-missing DOCS/README.TXT
# GUIDE.TXT を開くと新しい端末で edit が動く。Ctrl+Q で終わると端末も閉じる
key home
key down
key ret
wait-serial term: opened terminal 2
wait-serial files: opened /DOCS/GUIDE.TXT with edit in a terminal
wait-serial /DOCS/GUIDE.TXT
sleep 300
key ctrl+q
wait-serial term: closed terminal 2
sleep 300
# フォルダを作る（→ 404,253）
mouse-move 124 0
mouse-button left down
mouse-button left up
sleep 300
type NEWDIR
key ret
wait-serial files: made folder /DOCS/NEWDIR
# [x]（418〜437, 45〜64）で閉じる（→ 428,55）
mouse-move 24 -198
mouse-button left down
mouse-button left up
wait-serial files: closed
expect-disk-clean
serial-absent PANIC
