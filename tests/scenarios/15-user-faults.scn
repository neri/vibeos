# Phase 9: アプリの不正な動作ではカーネルが落ちず、そのプロセスだけが止まる
timeout 30
wait-serial VIBEOS READY
wait-serial VibeOS shell
type fault null
key ret
wait-serial Page fault (#PF)
wait-serial address 0x00000000), killed
wait-serial [fault exited with -128]
type fault kernel
key ret
wait-serial address 0x00100000), killed
type fault cli
key ret
wait-serial General protection (#GP)
type fault div0
key ret
wait-serial Divide error (#DE)
type fault stack
key ret
wait-serial recursing...
wait-serial Page fault (#PF)
type fault badptr
key ret
wait-serial write(kernel pointer) = -14
wait-serial write(beyond stack) = -14
wait-serial syscall 999 = -38
# 無限ループするプロセスを Ctrl+C で止める（その間もステータスバーは動く）
type fault spin
key ret
wait-serial spinning
expect-change 392 0 248 20 1500
key ctrl+c
wait-serial [fault exited with -130]
# それでもシェルは動いている
type hello
key ret
wait-serial Hello from user space!
serial-absent should not happen
serial-absent KERNEL PANIC
