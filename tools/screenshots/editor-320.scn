# README 用のスクリーンショット: 320x200 の画面でテキストエディタ
boot-config video=320x200
qemu-arg -rtc
qemu-arg base=2026-10-12T10:12:00
timeout 30
wait-serial VibeOS shell
type edit /docs/guide.txt
key ret
wait-serial /docs/guide.txt
key ctrl+f
type desktop
key ret
wait-serial Found at line
sleep 300
screendump editor-320
key ctrl+q
